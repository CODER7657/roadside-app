# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Keys and signing: never commit (PLAN §12.8). The root .gitignore's `env/*.json` only
# covers the repo root, so repeat it for this app.
/env/*.json
!/env/example.json

# Firebase config per flavour (#120, PLAN §12.8): from the Firebase console or
# `flutterfire configure`. Not secret, but kept out of git like env/*.json (the secret
# scanners flag its API key).
android/app/src/*/google-services.json
lib/firebase_options*.dart
