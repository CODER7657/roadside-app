  "help_faq_jobs_q": "How do I get jobs?",
  "@help_faq_jobs_q": { "description": "C9 FAQ (mechanic)." },
  "help_faq_jobs_a": "Once you're approved, go online on the home screen. Nearby breakdowns come to you as offers; slide to accept within 30 seconds.",
  "@help_faq_jobs_a": { "description": "C9 FAQ answer." },
  "help_faq_no_offers_q": "Why am I not getting offers?",
  "@help_faq_no_offers_q": { "description": "C9 FAQ (mechanic)." },
  "help_faq_no_offers_a": "Check that you're online, approved, and in your city, and that your vehicle types and services are set. Keep the app open with location on; offers only go to mechanics close by.",
