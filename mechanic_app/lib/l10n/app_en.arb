  "help_faq_jobs_q": "How do I get jobs?",
  "@help_faq_jobs_q": {
    "description": "C9 FAQ (mechanic)."
  },
  "help_faq_jobs_a": "Once you're approved, go online on the home screen. Nearby breakdowns come to you as offers; slide to accept within 30 seconds.",
  "@help_faq_jobs_a": {
    "description": "C9 FAQ answer."
  },
  "help_faq_no_offers_q": "Why am I not getting offers?",
  "@help_faq_no_offers_q": {
    "description": "C9 FAQ (mechanic)."
  },
  "help_faq_no_offers_a": "Check that you're online, approved, and in your city, and that your vehicle types and services are set. Keep the app open with location on; offers only go to mechanics close by.",
  "@help_faq_no_offers_a": {
    "description": "C9 FAQ answer."
  },
  "help_faq_verify_q": "How does verification work?",
  "@help_faq_verify_q": {
    "description": "C9 FAQ (mechanic)."
  },
  "help_faq_verify_a": "We check your ID and photos before you get jobs. If you work without a workshop, we also call you for a short verification.",
  "@help_faq_verify_a": {
    "description": "C9 FAQ answer."
  },
  "help_faq_code_q": "What is the start code?",
  "@help_faq_code_q": {
    "description": "C9 FAQ (mechanic)."
  },
  "help_faq_code_a": "When you arrive, the customer reads you a 4-digit code. Enter it to start the job. After 5 wrong tries it locks for 10 minutes.",
  "@help_faq_code_a": {
    "description": "C9 FAQ answer."
  },
  "help_faq_pay_q": "How do I get paid?",
  "@help_faq_pay_q": {
    "description": "C9 FAQ (mechanic)."
  },
  "help_faq_pay_a": "The customer pays you directly by UPI. Check your UPI app, then tap Confirm. If the money hasn't arrived, tap Not received and we'll look into it.",
  "@help_faq_pay_a": {
    "description": "C9 FAQ answer."
  },
  "help_faq_cancel_q": "Can I cancel a job?",
  "@help_faq_cancel_q": {
    "description": "C9 FAQ (mechanic)."
  },
  "help_faq_cancel_a": "Yes, but it counts against your reliability. Before you arrive, the job goes to another mechanic; after you arrive, tell us why.",
  "@help_faq_cancel_a": {
    "description": "C9 FAQ answer."
  },
