  "help_faq_code_q": "What is the start code?",
  "@help_faq_code_q": { "description": "C9 FAQ (mechanic)." },
  "help_faq_code_a": "When you arrive, the customer reads you a 4-digit code. Enter it to start the job. After 5 wrong tries it locks for 10 minutes.",
  "@help_faq_code_a": { "description": "C9 FAQ answer." },
  "help_faq_pay_q": "How do I get paid?",
  "@help_faq_pay_q": { "description": "C9 FAQ (mechanic)." },
  "help_faq_pay_a": "The customer pays you directly by UPI. Check your UPI app, then tap Confirm. If the money hasn't arrived, tap Not received and we'll look into it.",
  "@help_faq_pay_a": { "description": "C9 FAQ answer." },
  "help_faq_cancel_q": "Can I cancel a job?",
  "@help_faq_cancel_q": { "description": "C9 FAQ (mechanic)." },
