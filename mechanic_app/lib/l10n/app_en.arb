  "privacy_collect_title": "What we collect",
  "@privacy_collect_title": {
    "description": "Privacy notice section title."
  },
  "privacy_collect_body": "Your phone number, name and language; your profile and shop or toolkit photos; your ID proof (and, if you work without a shop, a selfie with it and an address proof) to verify you; your UPI ID and name; and your location while you're online or on a job.",
  "@privacy_collect_body": {
    "description": "Privacy notice: what we collect (mechanic)."
  },
  "privacy_use_title": "Why we use it",
  "@privacy_use_title": {
    "description": "Privacy notice section title."
  },
  "privacy_use_body": "To verify you, send you nearby jobs, show customers who is coming and where you are on the way, and let them pay you. We don't show ads or sell your data.",
  "@privacy_use_body": {
    "description": "Privacy notice: why (mechanic)."
  },
  "privacy_keep_title": "How long we keep it",
  "@privacy_keep_title": {
    "description": "Privacy notice section title."
  },
  "privacy_keep_body": "Your online location is replaced as you move and cleared when you go offline. Live location during a job: 24 hours after it ends. Chat: 90 days. ID documents: until 180 days after you leave. Job records: 3 years for tax.",
  "@privacy_keep_body": {
    "description": "Privacy notice: retention (mechanic, PLAN §12.10)."
  },
