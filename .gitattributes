# Normalise line endings so scripts and workflows behave the same on Windows and CI (Linux)
* text=auto eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff2 binary
*.jks binary
