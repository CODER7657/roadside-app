{
  "name": "roadside-functions",
  "private": true,
  "description": "Cloud Functions for the roadside app (PLAN.md §9, §11, §12.6)",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "lint": "eslint . && tsc -p tsconfig.dev.json",
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "serve": "npm run build && firebase emulators:start --project demo-roadside --only functions,firestore,auth"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
