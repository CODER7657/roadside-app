rules_version = '2';

// Firestore rules v1 (PLAN.md §8, §9, §12.4). Owner: P3.
//
// - Deny by default: every collection has an explicit match block; there's no wildcard allow.
// - Roles come from custom claims set by Functions (`role`, `mechanicStatus`), never from documents.
// - Every client write is limited with keys().hasOnly() / diff().affectedKeys().hasOnly(), and
//   createdAt / updatedAt must be server timestamps (== request.time).
// - 🔒 data (bookings, offers, OTPs, ratings, statuses, share links, rate limits) is written only by
//   Cloud Functions through the Admin SDK, which bypasses these rules.
// Every change here ships with tests in rules_tests/.

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------ helpers

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasRole(r) {
      return isSignedIn() && request.auth.token.get('role', '') == r;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isApprovedMechanic() {
      return hasRole('mechanic') && request.auth.token.get('mechanicStatus', '') == 'approved';
    }

    function authPhone() {
      return request.auth.token.get('phone_number', '');
    }

    function data() {
      return request.resource.data;
    }

    function onlyKeys(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isNewDoc() {
      return data().createdAt == request.time
        && data().updatedAt == request.time
        && data().schemaVersion == 1;
    }

    function isTouched() {
      return data().updatedAt == request.time;
    }

    function bookingAt(id) {
      return get(/databases/$(database)/documents/bookings/$(id)).data;
    }

    function isParticipant(b) {
      return isSignedIn() && (b.customerId == request.auth.uid || b.mechanicId == request.auth.uid);
    }

    function isActive(b) {
      return b.status in ['requested', 'accepted', 'arriving', 'arrived', 'in_progress'];
    }

    // ------------------------------------------------------------------ value checks

    function isStr(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function isStrOrNull(v, max) {
      return v == null || isStr(v, 0, max);
    }

    function isUrl(v) {
      return isStr(v, 9, 1024) && v.matches('^https://.+');
    }

    function isE164(v) {
      return v is string && v.matches('^\\+[1-9][0-9]{7,14}$');
    }

    // Standard series (GJ01AB1234) or BH series (22BH1234AA), normalised upper case.
    function isRegNo(v) {
      return v is string && v.matches('^([A-Z]{2}[0-9]{1,2}[A-Z]{0,3}[0-9]{4}|[0-9]{2}BH[0-9]{4}[A-Z]{1,2})$');
    }

    function isUpiId(v) {
      return v is string && v.matches('^[a-zA-Z0-9.\\-_]{2,256}@[a-zA-Z]{2,64}$');
    }

    function isCityId(v) {
      return v in ['ahmedabad', 'ankleshwar', 'bharuch'];
    }

    function isVehicleType(v) {
      return v in ['car', 'bike', 'scooter', 'ev'];
    }

    function isVehicleTypeList(l) {
      return l is list && l.size() >= 1 && l.size() <= 4 && l.hasOnly(['car', 'bike', 'scooter', 'ev']);
    }

    function isProblemTypeList(l) {
      return l is list && l.size() >= 1 && l.size() <= 7
        && l.hasOnly(['flat_tyre', 'battery', 'wont_start', 'overheating', 'accident', 'fuel', 'other']);
    }

    function isContact(c) {
      return c is map && c.keys().hasOnly(['name', 'phone']) && c.keys().hasAll(['name', 'phone'])
        && isStr(c.name, 1, 60) && isE164(c.phone);
    }

    // ≤ 3 emergency contacts (PLAN §8), each { name, phone }.
    function isContactList(l) {
      return l is list && l.size() <= 3
        && (l.size() < 1 || isContact(l[0]))
        && (l.size() < 2 || isContact(l[1]))
        && (l.size() < 3 || isContact(l[2]));
    }

    function isStoragePath(v, prefix) {
      return v is string && v.size() <= 300 && v.matches('^' + prefix + '[^/]{1,100}$');
    }

    // ------------------------------------------------------------------ users

    function isUserProfile(d) {
      return isStr(d.name, 1, 60)
        && d.language in ['en', 'hi', 'gu']
        && (!('emergencyContacts' in d) || isContactList(d.emergencyContacts))
        && (!('fcmToken' in d) || isStrOrNull(d.fcmToken, 4096))
        && (!('consent' in d) || d.consent == null
            || (d.consent is map && d.consent.keys().hasOnly(['version', 'acceptedAt'])
                && isStr(d.consent.version, 1, 20) && d.consent.acceptedAt is timestamp));
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && onlyKeys(['name', 'phone', 'language', 'emergencyContacts', 'fcmToken', 'consent',
                     'deletionRequestedAt', 'createdAt', 'updatedAt', 'schemaVersion'])
        && data().keys().hasAll(['name', 'phone', 'language', 'createdAt', 'updatedAt', 'schemaVersion'])
        && data().phone == authPhone()                                       // 🔒 from Auth
        && (!('deletionRequestedAt' in data()) || data().deletionRequestedAt == null)  // 🔒
        && isUserProfile(data())
        && isNewDoc();
      // Frozen once requestAccountDeletion has set deletionRequestedAt (🔒).
      allow update: if isSelf(uid)
        && resource.data.get('deletionRequestedAt', null) == null
        && changedOnly(['name', 'language', 'emergencyContacts', 'fcmToken', 'consent', 'updatedAt'])
        && isUserProfile(data())
        && isTouched();
      allow delete: if false; // requestAccountDeletion (callable)

      match /vehicles/{vehicleId} {
        function isVehicle(d) {
          return isVehicleType(d.type)
            && isStr(d.brand, 1, 40)
            && isStr(d.model, 1, 40)
            && isRegNo(d.regNo)
            && d.fuel in ['petrol', 'diesel', 'cng', 'electric']
            && d.isDefault is bool;
        }

        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid)
          && onlyKeys(['type', 'brand', 'model', 'regNo', 'fuel', 'isDefault', 'createdAt', 'updatedAt', 'schemaVersion'])
          && data().keys().hasAll(['type', 'brand', 'model', 'regNo', 'fuel', 'isDefault', 'createdAt', 'updatedAt', 'schemaVersion'])
          && isVehicle(data())
          && isNewDoc();
        allow update: if isSelf(uid)
          && changedOnly(['type', 'brand', 'model', 'regNo', 'fuel', 'isDefault', 'updatedAt'])
          && isVehicle(data())
          && isTouched();
        allow delete: if isSelf(uid);
      }
    }

    // ------------------------------------------------------------------ mechanics

    function mechanicCommonKeys() {
      return ['name', 'profilePhotoUrl', 'mechanicType', 'cityId', 'vehicleTypes', 'services',
              'status', 'rating', 'ratingCount', 'jobsCompleted', 'fcmToken',
              'createdAt', 'updatedAt', 'schemaVersion'];
    }

    function mechanicTypeKeys(type) {
      return type == 'workshop'
        ? ['shopName', 'shopAddress', 'shopPhotoUrl']
        : ['baseArea', 'experienceYears', 'toolkitPhotoUrls', 'travelVehicle'];
    }

    // Each type writes only its own fields (PLAN §10.0).
    function isMechanicProfile(d) {
      return onlyKeys(mechanicCommonKeys().concat(mechanicTypeKeys(d.mechanicType)))
        && d.keys().hasAll(['name', 'profilePhotoUrl', 'mechanicType', 'cityId', 'vehicleTypes', 'services'])
        && d.keys().hasAll(mechanicTypeKeys(d.mechanicType))
        && isStr(d.name, 1, 60)
        && isUrl(d.profilePhotoUrl)
        && isCityId(d.cityId)
        && isVehicleTypeList(d.vehicleTypes)
        && isProblemTypeList(d.services)
        && (!('fcmToken' in d) || isStrOrNull(d.fcmToken, 4096))
        && (d.mechanicType == 'workshop'
            ? (isStr(d.shopName, 1, 60) && isStr(d.shopAddress, 1, 300) && isUrl(d.shopPhotoUrl))
            : (d.baseArea is map && d.baseArea.keys().hasOnly(['locality', 'geopoint'])
               && isStr(d.baseArea.locality, 1, 100) && d.baseArea.geopoint is latlng
               && d.experienceYears is int && d.experienceYears >= 0 && d.experienceYears <= 60
               && d.toolkitPhotoUrls is list && d.toolkitPhotoUrls.size() >= 2 && d.toolkitPhotoUrls.size() <= 5
               && isUrl(d.toolkitPhotoUrls[0]) && isUrl(d.toolkitPhotoUrls[1])
               && d.travelVehicle is map && d.travelVehicle.keys().hasOnly(['type', 'regNo'])
               && isVehicleType(d.travelVehicle.type) && isRegNo(d.travelVehicle.regNo)));
    }

    // 🔒 fields may be sent on create only with their starting values.
    function hasStartingLockedValues(d) {
      return d.get('status', 'pending') == 'pending'
        && d.get('rating', 0) == 0
        && d.get('ratingCount', 0) == 0
        && d.get('jobsCompleted', 0) == 0;
    }

    match /mechanics/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      // M1 registration: any phone-verified user (role is still `customer` until
      // onMechanicRegistered switches it), type chosen once.
      allow create: if isSelf(uid)
        && authPhone() != ''
        && data().mechanicType in ['workshop', 'independent']
        && isMechanicProfile(data())
        && hasStartingLockedValues(data())
        && isNewDoc();

      // While pending: fix the profile (not type, city or 🔒 fields). After review: fcmToken only.
      // Once requestAccountDeletion has set deletionRequestedAt (🔒, never in mechanicCommonKeys, so
      // clients can't write it), the profile is frozen for the app, whatever the status.
      allow update: if isSelf(uid)
        && isTouched()
        && resource.data.get('deletionRequestedAt', null) == null
        && (resource.data.status == 'pending'
            ? (changedOnly(['name', 'profilePhotoUrl', 'vehicleTypes', 'services', 'fcmToken', 'updatedAt']
                           .concat(mechanicTypeKeys(resource.data.mechanicType)))
               && isMechanicProfile(data()))
            : (changedOnly(['fcmToken', 'updatedAt']) && isStrOrNull(data().fcmToken, 4096)));

      allow delete: if false;

      // KYC: written once while pending; admins read it; 🔒 fields only by the admin callable.
      match /private/{docId} {
        allow read: if docId == 'kyc' && (isSelf(uid) || isAdmin());
        allow create: if docId == 'kyc'
          && isSelf(uid)
          && isKyc(uid, data(), getAfter(/databases/$(database)/documents/mechanics/$(uid)).data)
          && isNewDoc();
        allow update, delete: if false;
      }
    }

    function isKyc(uid, d, mechanic) {
      return mechanic.status == 'pending'
        && onlyKeys(['phone', 'idProofPath', 'upiId', 'upiName', 'createdAt', 'updatedAt', 'schemaVersion']
                    .concat(mechanic.mechanicType == 'independent'
                            ? ['selfieWithIdPath', 'addressProofPath', 'referenceContact'] : []))
        && d.keys().hasAll(['phone', 'idProofPath', 'upiId', 'upiName'])
        && d.phone == authPhone()                                             // 🔒 from Auth
        && isStoragePath(d.idProofPath, 'mechanics/' + uid + '/kyc/')
        && isUpiId(d.upiId)
        && isStr(d.upiName, 1, 100)
        && (mechanic.mechanicType == 'workshop'
            || (isStoragePath(d.get('selfieWithIdPath', ''), 'mechanics/' + uid + '/kyc/')
                && isStoragePath(d.get('addressProofPath', ''), 'mechanics/' + uid + '/kyc/')
                && (!('referenceContact' in d) || d.referenceContact == null || isContact(d.referenceContact))));
    }

    // ------------------------------------------------------------------ presence

    function isGeoLocation(l) {
      return l is map && l.keys().hasOnly(['geopoint', 'geohash']) && l.keys().hasAll(['geopoint', 'geohash'])
        && l.geopoint is latlng && isStr(l.geohash, 1, 12);
    }

    match /presence/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      // First go-online: cityId must be the profile's, activeBookingId starts null (both 🔒 after).
      allow create: if isSelf(uid) && isApprovedMechanic()
        && onlyKeys(['isOnline', 'location', 'updatedAt', 'cityId', 'activeBookingId'])
        && data().keys().hasAll(['isOnline', 'location', 'updatedAt', 'cityId'])
        && data().isOnline is bool
        && isGeoLocation(data().location)
        && data().updatedAt == request.time
        && data().cityId == get(/databases/$(database)/documents/mechanics/$(uid)).data.cityId
        && data().get('activeBookingId', null) == null;
      allow update: if isSelf(uid) && isApprovedMechanic()
        && changedOnly(['isOnline', 'location', 'updatedAt'])
        && data().isOnline is bool
        && isGeoLocation(data().location)
        && data().updatedAt == request.time;
      allow delete: if false;
    }

    // ------------------------------------------------------------------ offers 🔒

    match /offers/{offerId} {
      allow read: if (hasRole('mechanic') && resource.data.mechanicId == request.auth.uid) || isAdmin();
      allow write: if false;
    }

    // ------------------------------------------------------------------ bookings 🔒

    match /bookings/{bookingId} {
      allow read: if isSignedIn()
        && (resource.data.customerId == request.auth.uid
            || resource.data.mechanicId == request.auth.uid
            || isAdmin());
      allow write: if false; // only Cloud Functions

      // Start code: the customer reads it; the mechanic never does (verifyStartOtp).
      match /private/{docId} {
        allow read: if docId == 'otp' && isSignedIn() && bookingAt(bookingId).customerId == request.auth.uid;
        allow write: if false;
      }

      // Chat: participants write while the booking is active; read for 30 days after it ends.
      match /messages/{messageId} {
        function chatReadable(b) {
          return isActive(b)
            || request.time < b.updatedAt + duration.value(30, 'd');
        }

        allow read: if isParticipant(bookingAt(bookingId)) && chatReadable(bookingAt(bookingId));
        allow create: if isParticipant(bookingAt(bookingId))
          && isActive(bookingAt(bookingId))
          && onlyKeys(['senderId', 'text', 'imagePath', 'createdAt'])
          && data().keys().hasAll(['senderId', 'text', 'createdAt'])
          && data().senderId == request.auth.uid
          && isStr(data().text, 0, 500)
          && (data().get('imagePath', null) == null
              || isStoragePath(data().imagePath, 'bookings/' + bookingId + '/chat/'))
          && (data().text.size() > 0 || data().get('imagePath', null) != null)
          && data().createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------------ live location

    match /liveLocations/{bookingId} {
      // The customer only while the booking is active (stalking control, PLAN §12.1).
      allow read: if isSignedIn()
        && ((bookingAt(bookingId).customerId == request.auth.uid && isActive(bookingAt(bookingId)))
            || bookingAt(bookingId).mechanicId == request.auth.uid
            || isAdmin());
      allow create, update: if isApprovedMechanic()
        && bookingAt(bookingId).mechanicId == request.auth.uid
        && bookingAt(bookingId).status in ['accepted', 'arriving', 'arrived', 'in_progress']
        && onlyKeys(['mechanicGeopoint', 'heading', 'speed', 'etaMinutes', 'updatedAt', 'expireAt'])
        && data().keys().hasAll(['mechanicGeopoint', 'heading', 'speed', 'etaMinutes', 'updatedAt', 'expireAt'])
        && data().mechanicGeopoint is latlng
        // geolocator reports -1 when heading / speed are unknown.
        && data().heading is number && data().heading >= -1 && data().heading <= 360
        && data().speed is number && data().speed >= -1 && data().speed <= 100
        && data().etaMinutes is int && data().etaMinutes >= 0 && data().etaMinutes <= 600
        && data().updatedAt == request.time
        // TTL field: about 24 h ahead (device clocks drift, so a window, not an exact value).
        && data().expireAt is timestamp
        && data().expireAt > request.time
        && data().expireAt < request.time + duration.value(48, 'h');
      allow delete: if false;
    }

    // ------------------------------------------------------------------ share links 🔒, rate limits 🔒

    match /shareLinks/{token} {
      allow read, write: if false; // getSharedTrip (callable) only
    }

    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------ prices

    function isRange(r) {
      return r is map && r.keys().hasOnly(['min', 'max']) && r.keys().hasAll(['min', 'max'])
        && r.min is int && r.max is int && r.min > 0 && r.min < r.max && r.max <= 100000;
    }

    match /prices/{priceId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        && priceId == data().vehicleType + '_' + data().problemType
        && onlyKeys(['vehicleType', 'problemType', 'min', 'max', 'includes', 'cityOverrides',
                     'createdAt', 'updatedAt', 'schemaVersion'])
        && isVehicleType(data().vehicleType)
        && data().problemType in ['flat_tyre', 'battery', 'wont_start', 'overheating', 'accident', 'fuel', 'other']
        && isRange({'min': data().min, 'max': data().max})
        && isStr(data().includes, 0, 200)
        && (!('cityOverrides' in data()) || data().cityOverrides == null
            || (data().cityOverrides is map
                && data().cityOverrides.keys().hasOnly(['ahmedabad', 'ankleshwar', 'bharuch'])
                && (!('ahmedabad' in data().cityOverrides) || isRange(data().cityOverrides.ahmedabad))
                && (!('ankleshwar' in data().cityOverrides) || isRange(data().cityOverrides.ankleshwar))
                && (!('bharuch' in data().cityOverrides) || isRange(data().cityOverrides.bharuch))))
        && isTouched()
        && data().schemaVersion == 1;
      allow delete: if false;
    }

    // ------------------------------------------------------------------ service areas

    match /serviceAreas/{cityId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && cityId.matches('^[a-z]{3,30}$')
        && onlyKeys(['name', 'center', 'radiusKm', 'active', 'supportPhone', 'launchedAt',
                     'createdAt', 'updatedAt', 'schemaVersion'])
        && data().keys().hasAll(['name', 'center', 'radiusKm', 'active', 'supportPhone'])
        && data().name is map && data().name.keys().hasOnly(['en', 'hi', 'gu']) && data().name.keys().hasAll(['en', 'hi', 'gu'])
        && isStr(data().name.en, 1, 60) && isStr(data().name.hi, 1, 60) && isStr(data().name.gu, 1, 60)
        && data().center is latlng
        && data().radiusKm is number && data().radiusKm > 0 && data().radiusKm <= 100
        && data().active is bool
        && isE164(data().supportPhone)
        && (data().get('launchedAt', null) == null || data().launchedAt is timestamp)
        && isTouched()
        && data().schemaVersion == 1;
      allow delete: if false;
    }

    // ------------------------------------------------------------------ reviews

    match /reviews/{bookingId} {
      allow read: if isSignedIn()
        && (resource.data.customerId == request.auth.uid
            || resource.data.mechanicId == request.auth.uid
            || isAdmin());
      // One per completed booking (the id is the booking id), by its customer.
      allow create: if isSignedIn()
        && bookingAt(bookingId).customerId == request.auth.uid
        && bookingAt(bookingId).status == 'completed'
        && onlyKeys(['customerId', 'mechanicId', 'stars', 'tags', 'comment', 'createdAt'])
        && data().keys().hasAll(['customerId', 'mechanicId', 'stars', 'createdAt'])
        && data().customerId == request.auth.uid
        && data().mechanicId == bookingAt(bookingId).mechanicId
        && data().stars is int && data().stars >= 1 && data().stars <= 5
        // Tag codes from U14 (customer_app ReviewTags): 4-5 stars offer the first four, 1-3 the rest.
        && (!('tags' in data()) || (data().tags is list && data().tags.size() <= 8
            && data().tags.hasOnly(['on_time', 'friendly', 'fixed_fast', 'fair_price',
                                    'late', 'rude', 'overcharged', 'not_fixed'])))
        && (!('comment' in data()) || isStr(data().comment, 0, 500))
        && data().createdAt == request.time;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------ complaints

    match /complaints/{complaintId} {
      allow read: if isSignedIn() && (resource.data.raisedBy == request.auth.uid || isAdmin());
      allow create: if isParticipant(bookingAt(data().bookingId))
        && onlyKeys(['bookingId', 'raisedBy', 'category', 'text', 'status', 'resolution', 'createdAt'])
        && data().keys().hasAll(['bookingId', 'raisedBy', 'category', 'text', 'status', 'createdAt'])
        && data().raisedBy == request.auth.uid
        && data().category in ['payment', 'service', 'safety', 'other'] // A5 filters on these
        && isStr(data().text, 1, 1000)
        && data().status == 'open'
        && data().get('resolution', null) == null
        && data().createdAt == request.time;
      // A5: admins resolve. Same batch writes an auditLogs entry.
      allow update: if isAdmin()
        && changedOnly(['status', 'resolution'])
        && data().status in ['open', 'resolved']
        && isStrOrNull(data().resolution, 1000);
      allow delete: if false;
    }

    // ------------------------------------------------------------------ inbox 🔒

    match /inbox/{uid}/items/{itemId} {
      allow read: if isSelf(uid);
      allow update: if isSelf(uid) && changedOnly(['read']) && data().read is bool;
      allow create, delete: if false;
    }

    // ------------------------------------------------------------------ app config

    match /appConfig/{docId} {
      allow read: if docId == 'public';
      allow create, update: if isAdmin()
        && docId == 'public'
        && onlyKeys(['minSupportedBuild', 'maintenanceMessage', 'supportPhone', 'dispatchEnabled'])
        && data().keys().hasAll(['minSupportedBuild', 'supportPhone', 'dispatchEnabled'])
        && data().minSupportedBuild is int && data().minSupportedBuild >= 0
        && isStrOrNull(data().get('maintenanceMessage', null), 500)
        && isE164(data().supportPhone)
        && data().dispatchEnabled is bool;
      allow delete: if false;
    }

    // ------------------------------------------------------------------ admin-only

    // Admin writes to prices / serviceAreas / appConfig / complaints add one entry here in the same
    // batch. Append-only: nobody edits or deletes history.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && onlyKeys(['actorUid', 'action', 'target', 'before', 'after', 'at'])
        && data().keys().hasAll(['actorUid', 'action', 'target', 'at'])
        && data().actorUid == request.auth.uid
        && isStr(data().action, 1, 60)
        && isStr(data().target, 1, 300)
        && data().at == request.time;
      allow update, delete: if false;
    }

    // Readable list for the admin panel. Rules trust the claim, not this collection.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Server-only allow-list for the beforeSignIn blocking function (PLAN §12.11).
    match /adminAllowlist/{email} {
      allow read, write: if false;
    }
  }
}
